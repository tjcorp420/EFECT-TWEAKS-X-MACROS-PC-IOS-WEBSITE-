{
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=()" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/downloads/EMX-Window-Deck_0.4.2_CUSTOMER-PACKAGE.zip",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/zip"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"EMX-Window-Deck_0.4.2_CUSTOMER-PACKAGE.zip\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/API/PAYHIP-WEBHOOK",
      "destination": "/api/payhip-webhook"
    },
    {
      "source": "/links",
      "destination": "/links.html"
    },
    {
      "source": "/affiliate",
      "destination": "/affiliate.html"
    },
    {
      "source": "/aim-trainer",
      "destination": "/aim-trainer.html"
    },
    {
      "source": "/download/aim-trainer",
      "destination": "/api/aim-trainer-download"
    },
    {
      "source": "/linktree",
      "destination": "/links.html"
    },
    {
      "source": "/hub",
      "destination": "/links.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/product-control",
      "destination": "/admin.html"
    },
    {
      "source": "/affiliate-admin",
      "destination": "/affiliate-admin.html"
    },
    {
      "source": "/affiliate-command",
      "destination": "/affiliate-admin.html"
    },
    {
      "source": "/dashboard",
      "destination": "/admin.html"
    },
    {
      "source": "/c/:creator",
      "destination": "/index.html"
    },
    {
      "source": "/c/:creator/:path*",
      "destination": "/:path*"
    },
    {
      "source": "/r/:creator",
      "destination": "/index.html"
    },
    {
      "source": "/r/:creator/:path*",
      "destination": "/:path*"
    }
  ]
}
