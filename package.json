{
  "name": "emx-tweaks-site",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "check": "node scripts/validate-site.js",
    "test": "node --test tests/*.test.js",
    "optimize:images": "python scripts/optimize-screenshots.py",
    "build:client": "esbuild scripts/product-upload-entry.mjs --bundle --minify --platform=browser --target=es2020 --outfile=product-upload-client.js",
    "prebuild": "npm run build:client",
    "build": "node scripts/build-site.js"
  },
  "dependencies": {
    "@vercel/blob": "^2.4.0",
    "firebase-admin": "^14.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
